# Supabase project settings → API. Both values are safe to ship to the browser
# (the anon key is a public key protected by Row Level Security).
# Leave both empty to run in LOCAL MODE: projects are stored in this browser's
# IndexedDB and no account is needed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the Supabase service-role key in this file or anywhere in the
# frontend. It bypasses Row Level Security.
