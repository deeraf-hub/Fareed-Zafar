# ── Meta App ──────────────────────────────────────────────────────────────────
# From https://developers.facebook.com → your app → App settings → Basic
APP_SECRET=your_meta_app_secret

# Any random string you choose. You will paste the same value into the
# webhook configuration screen in the Meta App Dashboard.
VERIFY_TOKEN=choose_a_long_random_string

# ── Facebook Page (Messenger side) ───────────────────────────────────────────
# Page access token with pages_messaging permission.
# Generate a long-lived token (see README "Step 3").
PAGE_ACCESS_TOKEN=your_page_access_token

# ── WhatsApp Business Cloud API (sending side) ───────────────────────────────
# From App Dashboard → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# The WhatsApp number that should RECEIVE the forwarded messages,
# in international format without "+" or spaces, e.g. 971501234567
WHATSAPP_RECIPIENT=971501234567

# ── Template fallback (for messages outside the 24-hour window) ──────────────
# Name of an APPROVED utility template with exactly two body variables:
#   {{1}} = sender name, {{2}} = message preview.
# Leave empty to disable the fallback (forwarding will then fail silently
# outside the 24h window — not recommended).
WHATSAPP_TEMPLATE_NAME=new_messenger_message
WHATSAPP_TEMPLATE_LANG=en

# ── Misc ─────────────────────────────────────────────────────────────────────
# IANA timezone used to format the date/time line of forwarded messages.
TIMEZONE=Asia/Dubai

# Graph API version used for all calls.
GRAPH_API_VERSION=v21.0

PORT=3000

# ── Seedance 2.5 video generation (optional, used by `npm run video`) ────────
# You need ONE of the two keys below. Never commit the real key.
#
# Option A — BytePlus ModelArk (ByteDance's official API).
#   Create the key in the ModelArk console → API Key management, then activate
#   Seedance 2.5 (needs a purchased resource pack). Keys are region-bound; the
#   default endpoint is Asia-Pacific, so leave ARK_BASE_URL unset.
ARK_API_KEY=your_byteplus_modelark_api_key
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDANCE_MODEL=dreamina-seedance-2-5-260628
#
# Option B — fal.ai (reseller; simpler signup, pay-as-you-go by card).
#   Create the key at https://fal.ai/dashboard/keys
# FAL_KEY=your_fal_api_key
# FAL_BASE_URL=https://queue.fal.run
#
# With both keys set, pick the default provider (byteplus | fal).
# SEEDANCE_PROVIDER=byteplus
