# Copy to .env next to docker-compose.yml. Never commit .env.
N8N_HOST=n8n.yourdomain.com
GENERIC_TIMEZONE=Asia/Karachi
# 32+ random characters; encrypts the credentials stored by n8n. Losing it = re-entering every credential.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Leave empty for the latest image on first install; then pin the version you tested, e.g. N8N_VERSION=1.xx.x
N8N_VERSION=
