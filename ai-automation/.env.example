# ---------------------------------------------------------------------------
# Model access
# ---------------------------------------------------------------------------
# Anthropic API key. The SDK also accepts ANTHROPIC_AUTH_TOKEN or an
# `ant auth login` profile — never hardcode a key in source.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides. Opus 5 is the default; effort, not a model downgrade, is
# the cost lever. "low" | "medium" | "high" | "xhigh" | "max".
AIAUTO_MODEL=claude-opus-5
AIAUTO_EFFORT=high
AIAUTO_MAX_TOKENS=8000
AIAUTO_TIMEOUT_S=120

# ---------------------------------------------------------------------------
# HTTP service
# ---------------------------------------------------------------------------
# Bearer token every caller (n8n included) must present. Leave unset only when
# the service is not reachable from outside your own network.
AIAUTO_API_TOKEN=change-me

# ---------------------------------------------------------------------------
# n8n workflow environment (set these in n8n, not here)
# ---------------------------------------------------------------------------
# AIAUTO_BASE_URL=http://aiauto:8000
# MERCHANT_NAME=Karachi Coffee Roasters
# MERCHANT_INDUSTRY=specialty coffee retail
# REVIEW_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# QUEUE_WEBHOOK_URL=https://...
# CONTENT_LOG_WEBHOOK_URL=https://...
# FB_PAGE_ID=
# FB_PAGE_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
