{
  "name": "Inbox triage and reply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inbox-triage",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "message-received",
      "name": "Message received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -220,
        300
      ],
      "webhookId": "aiauto-inbox-triage"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AIAUTO_BASE_URL }}/inbox/triage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AIAUTO_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ merchant: { name: $env.MERCHANT_NAME, industry: $env.MERCHANT_INDUSTRY }, message: $json.body.message, sender: $json.body.sender_name }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "triage-the-message",
      "name": "Triage the message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c-auto_reply",
                    "leftValue": "={{ $json.output.route }}",
                    "rightValue": "auto_reply",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "auto_reply"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c-escalate_now",
                    "leftValue": "={{ $json.output.route }}",
                    "rightValue": "escalate_now",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "escalate_now"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c-human_queue",
                    "leftValue": "={{ $json.output.route }}",
                    "rightValue": "human_queue",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "human_queue"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c-drop",
                    "leftValue": "={{ $json.output.route }}",
                    "rightValue": "drop",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "drop"
            }
          ]
        },
        "options": {}
      },
      "id": "route",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('Message received').item.json.body.sender_phone, type: 'text', text: { body: $json.output.suggested_reply } }) }}",
        "options": {}
      },
      "id": "send-the-reply",
      "name": "Send the reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `URGENT \u2014 ${$json.output.intent} from ${$('Message received').item.json.body.sender_name}\\n${$json.output.summary}\\n\\nDraft reply:\\n${$json.output.suggested_reply}` }) }}",
        "options": {}
      },
      "id": "alert-the-owner",
      "name": "Alert the owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.QUEUE_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ intent: $json.output.intent, urgency: $json.output.urgency, summary: $json.output.summary, draft: $json.output.suggested_reply }) }}",
        "options": {}
      },
      "id": "add-to-the-human-queue",
      "name": "Add to the human queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        440
      ]
    },
    {
      "parameters": {},
      "id": "ignore",
      "name": "Ignore",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        560,
        600
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, route: $json.output ? $json.output.route : 'drop' }) }}",
        "options": {}
      },
      "id": "acknowledge",
      "name": "Acknowledge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        860,
        300
      ]
    }
  ],
  "connections": {
    "Message received": {
      "main": [
        [
          {
            "node": "Triage the message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triage the message": {
      "main": [
        [
          {
            "node": "Route",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route": {
      "main": [
        [
          {
            "node": "Send the reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert the owner",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Add to the human queue",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ignore",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send the reply": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert the owner": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add to the human queue": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ignore": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "tags": [
    {
      "name": "aiauto"
    }
  ]
}
