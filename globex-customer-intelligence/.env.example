# ---- Database -------------------------------------------------------------
# SQLAlchemy URL used by the API, the CLI and Alembic.
DATABASE_URL=postgresql+psycopg://gci:gci@localhost:5432/gci
# Used only by pytest (a separate database that tests may truncate).
TEST_DATABASE_URL=postgresql+psycopg://gci:gci@localhost:5432/gci_test

# Values consumed by docker-compose.yml to create the database container.
POSTGRES_USER=gci
POSTGRES_PASSWORD=gci
POSTGRES_DB=gci

# ---- Model and experiment storage ------------------------------------------
# Fitted pipelines, scalers and cluster models are written here (durable volume in Docker).
MODEL_STORE_DIR=./models
# MLflow tracking URI. A local directory keeps the demo self-contained; point it at a
# tracking server (http://mlflow:5000) for a shared setup.
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=globex-customer-intelligence

# ---- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
# Set to "true" to expose write/maintenance endpoints (none are exposed by default).
ENABLE_ADMIN_ENDPOINTS=false

# ---- Frontend ---------------------------------------------------------------
# Base URL the browser uses to reach the API (Vite reads variables prefixed VITE_).
VITE_API_BASE_URL=http://localhost:8000
