# Mortar configuration. Copy to .env — every value is optional for `npm run demo`.
# Going live is configuration, not code: flip one system at a time to "live".

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_BASE_URL=https://mortar.example.com   # Twilio signs webhooks against this exact URL
DB_PATH=./var/mortar.db                      # SQLite (WAL); the demo uses :memory:
TIMEZONE=America/Chicago
LOG_FORMAT=json                              # json | pretty
LOG_LEVEL=info
# MORTAR_DEMO=1                              # same as `npm run demo`

# ── Security ──────────────────────────────────────────────────────────────────
MORTAR_WEBHOOK_SECRET=change-me              # HMAC for /events and /directory/sync (n8n signs with it)
CONSOLE_TOKEN=                               # set it in production; open the console once as /?token=…
VERIFY_TWILIO_SIGNATURES=true

# ── Models: local first, frontier only where it earns its cost ───────────────
LOCAL_MODEL_PROVIDER=simulated               # ollama | openai-compatible | simulated | none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=                                # empty = first installed chat model (pin it in production)
OPENAI_COMPAT_URL=http://localhost:8000      # vLLM, llama.cpp server, LM Studio
OPENAI_COMPAT_MODEL=                         # empty = first model the server lists
OPENAI_COMPAT_API_KEY=

ANTHROPIC_API_KEY=                           # set it and the frontier tier turns on
FRONTIER_PROVIDER=                           # anthropic | simulated | none (default: anthropic if a key is set)
FRONTIER_MODEL=                              # pin an exact model id in production; empty = newest model of the family
FRONTIER_MODEL_FAMILY=opus
FRONTIER_USD_PER_MTOK_IN=5                   # your model's list price, for the ledger and the budget
FRONTIER_USD_PER_MTOK_OUT=25
FRONTIER_DAILY_BUDGET_USD=5                  # past this, frontier tasks fall back to rules/local
EMBEDDINGS_PROVIDER=none                     # ollama = fuse embeddings with BM25 (reciprocal rank fusion)
EMBEDDINGS_MODEL=                            # e.g. an Ollama embedding model you have pulled
MODEL_TIMEOUT_MS=30000
MODEL_CIRCUIT_FAILURES=3
MODEL_CIRCUIT_COOLDOWN_MS=60000

# ── Connectors: simulated | live (per system; CONNECTORS sets the default) ───
CONNECTORS=simulated

TWILIO_MODE=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

EMAIL_MODE=simulated                         # outbound email via Postmark
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=maintenance@example.com

FUB_MODE=simulated                           # Follow Up Boss
FUB_API_KEY=
FUB_SYSTEM_NAME=Mortar
FUB_SYSTEM_KEY=                              # also verifies FUB webhook signatures

RENTVINE_MODE=simulated
RENTVINE_BASE_URL=                           # https://<company>.rentvine.com/api/manager
RENTVINE_API_KEY=
RENTVINE_API_SECRET=
RENTVINE_PRIORITY_IDS={"P1":1,"P2":2,"P3":3}  # account-specific: GET /maintenance/work-order/statuses
RENTVINE_STATUS_IDS={"open":1,"in_progress":2,"completed":3}

SHOWMOJO_WEBHOOK_TOKEN=                      # Bearer token on POST /webhooks/showmojo

# ── Workers ───────────────────────────────────────────────────────────────────
OUTBOX_POLL_MS=500
OUTBOX_MAX_ATTEMPTS=6
SCHEDULER_POLL_MS=1000
