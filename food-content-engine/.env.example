# Claude API key used for AI tagging, natural-language search, caption copy and B-roll prompts.
# Leave unset to run the engine in OFFLINE mode (tags come from the file/folder naming convention only).
ANTHROPIC_API_KEY=

# Optional overrides
# FCE_AI_MODE=auto        # auto | claude | offline
# FCE_MODEL=claude-opus-5
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
