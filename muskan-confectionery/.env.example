# Copy this file to .env and fill in real values before going live.
# Leave payment gateway sections blank to run the site with the built-in
# manual JazzCash/EasyPaisa mobile-account-transfer flow + Cash on Delivery.

PORT=3000

# ---- JazzCash Hosted Checkout Page ------------------------------------
# From JazzCash merchant onboarding (Mobile Account / HCP integration).
# JAZZCASH_ENV=sandbox until you're ready to accept live payments.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox

# ---- EasyPaisa Easypay --------------------------------------------------
# From EasyPaisa / Telenor Microfinance Bank merchant onboarding.
# EASYPAISA_ENV=sandbox until you're ready to accept live payments.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=sandbox
