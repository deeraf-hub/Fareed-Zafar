# Prototype admin credentials. Copy this file to `.env.local` and set your own
# values. These are build-time values in a frontend-only prototype — replace the
# check in src/store/AdminAuthContext.tsx with real server-side auth (Supabase)
# before this store handles live orders.
VITE_ADMIN_EMAIL=admin@qalandariautos.pk
VITE_ADMIN_PASSWORD=change-me

