# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://brandsloop:brandsloop@localhost:5432/brandsloop?schema=public"
# Separate database used by `npm test` — it is wiped between runs.
TEST_DATABASE_URL="postgresql://brandsloop:brandsloop@localhost:5432/brandsloop_test?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. MUST be set to a long random value in
# production, e.g. `openssl rand -hex 48`.
JWT_SECRET="change_me_to_a_long_random_string"
# Session lifetime in hours.
SESSION_HOURS=12

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (dev client runs on 5173).
CORS_ORIGINS="http://localhost:5173"
# Set to true when serving behind HTTPS so the session cookie gets `Secure`.
COOKIE_SECURE=false

# ── First-run admin account (used by `npm run db:seed`) ───────────────────────
# No production password is hard-coded anywhere in the source. If these are not
# set, the seed generates a random password and prints it once to the console.
SEED_ADMIN_EMAIL="admin@brandsloop.pk"
SEED_ADMIN_NAME="Brandsloop Admin"
SEED_ADMIN_PASSWORD=
# Set to "false" to seed only the admin user + settings (no demo catalogue).
SEED_DEMO_DATA=true
