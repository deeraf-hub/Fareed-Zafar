// Brandsloop Inventory Management System — database schema
// Postgres + Prisma. Money is stored as Decimal(14,2); quantities are integers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  STORE
  WAREHOUSE
  OUTLET
  ONLINE
}

enum MovementType {
  PURCHASE
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGED
  LOST
  OPENING_STOCK
  STOCK_COUNT
  SALE_CANCELLED
  PURCHASE_CANCELLED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  EASYPAISA
  JAZZCASH
  OTHER
}

enum ReturnType {
  CUSTOMER
  SUPPLIER
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
}

enum AdjustmentReason {
  DAMAGED
  LOST
  FOUND
  COUNTING_ERROR
  OPENING_STOCK
  MANUAL_CORRECTION
  OTHER
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  STOCK_ADJUSTMENT
  PENDING_PURCHASE
  PENDING_STOCK_COUNT
  SYSTEM
}

enum NotificationLevel {
  INFO
  WARNING
  CRITICAL
}

// ─────────────────────────────── People ───────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  phone        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movements        StockMovement[]
  purchases        Purchase[]
  sales            Sale[]
  returns          Return[]
  adjustments      StockAdjustment[]
  stockCounts      StockCount[]
  stockTransfers   StockTransfer[]
  auditLogs        AuditLog[]

  @@index([role])
  @@index([email])
}

model Customer {
  id        String      @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  notes     String?
  status    PartyStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  sales   Sale[]
  returns Return[]

  @@index([name])
  @@index([phone])
}

model Supplier {
  id            String      @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  taxNumber     String?
  notes         String?
  status        PartyStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products  Product[]
  purchases Purchase[]
  returns   Return[]

  @@index([name])
  @@index([status])
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([name])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Location {
  id        String       @id @default(cuid())
  name      String       @unique
  code      String       @unique
  type      LocationType @default(STORE)
  address   String?
  city      String?
  isActive  Boolean      @default(true)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  inventory       Inventory[]
  movements       StockMovement[]
  purchases       Purchase[]
  sales           Sale[]
  returns         Return[]
  adjustments     StockAdjustment[]
  stockCounts     StockCount[]
  transfersFrom   StockTransfer[]   @relation("TransferFrom")
  transfersTo     StockTransfer[]   @relation("TransferTo")

  @@index([isActive])
}

model Product {
  id            String        @id @default(cuid())
  name          String
  sku           String        @unique
  barcode       String?       @unique
  description   String?
  categoryId    String?
  brandId       String?
  supplierId    String?
  imageUrl      String?
  images        String[]      @default([])
  costPrice     Decimal       @default(0) @db.Decimal(14, 2)
  sellingPrice  Decimal       @default(0) @db.Decimal(14, 2)
  wholesalePrice Decimal?     @db.Decimal(14, 2)
  taxRate       Decimal       @default(0) @db.Decimal(6, 3)
  minStock      Int           @default(0)
  maxStock      Int?
  reorderLevel  Int           @default(0)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@index([brandId])
  @@index([status])
  @@index([sku])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  barcode      String?  @unique
  size         String?
  color        String?
  style        String?
  material     String?
  fit          String?
  costPrice    Decimal  @db.Decimal(14, 2)
  sellingPrice Decimal  @db.Decimal(14, 2)
  minStock     Int      @default(0)
  reorderLevel Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory        Inventory[]
  movements        StockMovement[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  returnItems      ReturnItem[]
  adjustmentItems  StockAdjustmentItem[]
  countItems       StockCountItem[]
  transferItems    StockTransferItem[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive])
}

// ───────────────────────────── Inventory ─────────────────────────────

model Inventory {
  id         String   @id @default(cuid())
  variantId  String
  locationId String
  quantity   Int      @default(0)
  reserved   Int      @default(0)
  damaged    Int      @default(0)
  updatedAt  DateTime @updatedAt

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([locationId])
  @@index([quantity])
}

model StockMovement {
  id              String       @id @default(cuid())
  variantId       String
  locationId      String
  type            MovementType
  quantity        Int // signed: positive = in, negative = out
  previousQty     Int
  newQty          Int
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  userId          String?
  notes           String?
  createdAt       DateTime     @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

// ───────────────────────────── Purchasing ────────────────────────────

model Purchase {
  id            String         @id @default(cuid())
  number        String         @unique
  supplierId    String
  locationId    String
  status        PurchaseStatus @default(DRAFT)
  orderDate     DateTime       @default(now())
  expectedDate  DateTime?
  receivedDate  DateTime?
  subtotal      Decimal        @default(0) @db.Decimal(14, 2)
  discount      Decimal        @default(0) @db.Decimal(14, 2)
  tax           Decimal        @default(0) @db.Decimal(14, 2)
  total         Decimal        @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(14, 2)
  paymentStatus PaymentStatus  @default(UNPAID)
  notes         String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  location  Location       @relation(fields: [locationId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseItem[]
  returns   Return[]

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([locationId])
}

model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  variantId   String
  quantity    Int
  receivedQty Int     @default(0)
  unitCost    Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  tax         Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
  @@index([variantId])
}

// ─────────────────────────────── Sales ───────────────────────────────

model Sale {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String?
  locationId    String
  status        SaleStatus    @default(DRAFT)
  saleDate      DateTime      @default(now())
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  tax           Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(UNPAID)
  notes         String?
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  location  Location   @relation(fields: [locationId], references: [id])
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     SaleItem[]
  returns   Return[]

  @@index([customerId])
  @@index([status])
  @@index([saleDate])
  @@index([locationId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)
  unitCost  Decimal @db.Decimal(14, 2) // captured at sale time for profit reporting
  discount  Decimal @default(0) @db.Decimal(14, 2)
  tax       Decimal @default(0) @db.Decimal(14, 2)
  total     Decimal @db.Decimal(14, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
}

// ────────────────────────────── Returns ──────────────────────────────

model Return {
  id           String     @id @default(cuid())
  number       String     @unique
  type         ReturnType
  saleId       String?
  purchaseId   String?
  customerId   String?
  supplierId   String?
  locationId   String
  returnDate   DateTime   @default(now())
  reason       String?
  refundAmount Decimal    @default(0) @db.Decimal(14, 2)
  notes        String?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sale      Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase  Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  customer  Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier  Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location  Location     @relation(fields: [locationId], references: [id])
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     ReturnItem[]

  @@index([type])
  @@index([returnDate])
  @@index([saleId])
  @@index([purchaseId])
}

model ReturnItem {
  id        String          @id @default(cuid())
  returnId  String
  variantId String
  quantity  Int
  condition ReturnCondition @default(RESELLABLE)
  unitPrice Decimal         @default(0) @db.Decimal(14, 2)
  reason    String?

  return  Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([returnId])
  @@index([variantId])
}

// ──────────────────────── Adjustments / Counts ───────────────────────

model StockAdjustment {
  id           String           @id @default(cuid())
  number       String           @unique
  locationId   String
  reason       AdjustmentReason
  notes        String?
  createdById  String?
  adjustedAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())

  location  Location              @relation(fields: [locationId], references: [id])
  createdBy User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     StockAdjustmentItem[]

  @@index([locationId])
  @@index([adjustedAt])
}

model StockAdjustmentItem {
  id           String @id @default(cuid())
  adjustmentId String
  variantId    String
  previousQty  Int
  newQty       Int
  difference   Int

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variant    ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([adjustmentId])
  @@index([variantId])
}

model StockCount {
  id          String           @id @default(cuid())
  number      String           @unique
  locationId  String
  status      StockCountStatus @default(DRAFT)
  notes       String?
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  location  Location         @relation(fields: [locationId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     StockCountItem[]

  @@index([locationId])
  @@index([status])
  @@index([startedAt])
}

model StockCountItem {
  id         String @id @default(cuid())
  countId    String
  variantId  String
  systemQty  Int
  countedQty Int?
  difference Int    @default(0)
  notes      String?

  count   StockCount     @relation(fields: [countId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([countId, variantId])
  @@index([countId])
}

model StockTransfer {
  id             String         @id @default(cuid())
  number         String         @unique
  fromLocationId String
  toLocationId   String
  status         TransferStatus @default(DRAFT)
  transferDate   DateTime       @default(now())
  completedAt    DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items        StockTransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([transferDate])
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  variantId  String
  quantity   Int

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([variantId])
}

// ──────────────────────── System / operations ────────────────────────

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ip       String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String            @id @default(cuid())
  type      NotificationType
  level     NotificationLevel @default(INFO)
  title     String
  message   String
  entity    String?
  entityId  String?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@unique([type, entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
